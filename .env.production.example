NODE_ENV=production
PORT=3000
DATA_DIR=/app/data

APP_ACCESS_PASSWORD=
APP_SESSION_SECRET=
# 没有 HTTPS 时保持 false；配置 HTTPS 后可改 true
APP_COOKIE_SECURE=false

OPENAI_API_KEY=
# 如果你用的是代理/中转/兼容 OpenAI 协议的服务，填这里，例如 https://api.openai.com/v1
OPENAI_BASE_URL=https://api.modelverse.cn
OPENAI_MODEL=gpt-5.5

# AI 生成超时控制（毫秒，可选）。生成走流式，只统计“无新内容”的停滞时间。
# AI_STALL_TIMEOUT_MS：连续多久没有返回新 token 才判定失败，默认 90000（90 秒）
# AI_TOTAL_TIMEOUT_MS：单次请求总时长兜底上限，默认 600000（10 分钟）
# AI_STALL_TIMEOUT_MS=90000
# AI_TOTAL_TIMEOUT_MS=600000

# 单次生成输出 token 上限，默认 16384。deepseek 等推理模型的思考过程也计入输出，
# 长文建议调大到 32768，避免 JSON 被截断报「AI 返回内容不是合法 JSON」。
# AI_MAX_TOKENS=32768

# 默认关闭推理模型的思考过程（思考 token 同样计入输出上限且显著拖慢速度）。
# 如需恢复模型思考，设为 1。
# AI_ENABLE_THINKING=1

FEISHU_APP_ID=
FEISHU_APP_SECRET=
