NODE_ENV=production
PORT=3000
DATA_DIR=/app/data

APP_ACCESS_PASSWORD=
APP_SESSION_SECRET=
# 没有 HTTPS 时保持 false；配置 HTTPS 后可改 true
APP_COOKIE_SECURE=false

OPENAI_API_KEY=
# 如果你用的是代理/中转/兼容 OpenAI 协议的服务，填这里，例如 https://api.openai.com/v1
OPENAI_BASE_URL=https://api.modelverse.cn
OPENAI_MODEL=gpt-5.5

FEISHU_APP_ID=
FEISHU_APP_SECRET=
