OPENAI_API_KEY=
# 如果你用的是代理/中转/兼容 OpenAI 协议的服务，填这里，例如 https://api.openai.com/v1
OPENAI_BASE_URL=
# 模型名，例如 gpt-5.5、gpt-4.1、gpt-4o 等
OPENAI_MODEL=gpt-5.5

# 可选：AI 生成超时控制（毫秒）。流式生成，只统计“无新内容”的停滞时间。
# AI_STALL_TIMEOUT_MS：连续多久没有返回新 token 才判定失败，默认 90000（90 秒）
# AI_TOTAL_TIMEOUT_MS：单次请求总时长兜底上限，默认 600000（10 分钟）
# AI_STALL_TIMEOUT_MS=90000
# AI_TOTAL_TIMEOUT_MS=600000

FEISHU_APP_ID=
FEISHU_APP_SECRET=
